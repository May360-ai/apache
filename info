            Cruds::insertEst();
        }
        break;

    case 'DELETE':
        if ($table == 'materia') {
            Cruds::deleteMat();
        } else {
            Cruds::deleteEst();
        }
        break;

    case 'PUT':
        if ($table == 'materia') {
            Cruds::updateMat();
        } else {
            Cruds::updateEst();
        }
        break;
    
    case 'OPTIONS':
        // Manejo de pre-flight para CORS
        http_response_code(200);
        break;

    default:
        http_response_code(405);
        echo json_encode(["error" => "Método no permitido"]);
